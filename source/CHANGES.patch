+	return true
+
+static func _restore_thing(m, e: Dictionary):
+	var kind: String = e["kind"]
+	var built := _built(e)
+	var b = null
+	match String(e.get("type", "")):
+		"ground":
+			var c: Vector2i = e["cell"]
+			if built:
