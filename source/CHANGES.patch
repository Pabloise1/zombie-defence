diff -ruN src_orig/scripts/maps/city_art.gd src/scripts/maps/city_art.gd
--- a/scripts/maps/city_art.gd	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/maps/city_art.gd	2026-10-25 08:08:36.618548509 +0000
@@ -0,0 +1,329 @@
+class_name CityArt
+extends RefCounted
+# Procedural city blocks. Every tower is a few boxes merged into a handful of
+# chunk meshes (one draw call each); windows, shopfronts and grime come from
+# one shader that reads metric UVs, so no textures and very few vertices.
+# Facade vertices: COLOR.rgb = wall colour, COLOR.a = 1 (windowed),
+# UV = (metres along the facade, height), UV2 = (facade length, code) where
+# code = style + 4 * seed + 1024 * burnt. Roof bits have COLOR.a = 0.
+const ROOFS := [Color(0.55, 0.55, 0.53), Color(0.47, 0.48, 0.49), Color(0.6, 0.57, 0.51), Color(0.42, 0.42, 0.43), Color(0.52, 0.47, 0.42)]
+const CONCRETE := Color(0.62, 0.61, 0.58)
+const METAL := Color(0.5, 0.52, 0.53)
+const TANK := Color(0.56, 0.43, 0.3)
+static var _mat: ShaderMaterial
+static var _heap: ArrayMesh
+
+const SHADER := """
+shader_type spatial;
+render_mode cull_back, diffuse_burley;
+uniform sampler2D grime_tex : filter_linear_mipmap, repeat_enable;
+uniform float ground_h = 4.2;
+uniform float floor_h = 3.2;
+uniform float fill = 0.22;
+varying vec3 wp;
+varying vec3 wn;
+void vertex() {
+	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
+}
+float hash2(vec2 p) {
+	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
+	p3 += dot(p3, p3.yzx + 33.33);
+	return fract((p3.x + p3.y) * p3.z);
+}
+float band(float x, float a, float b, float w) {
+	return smoothstep(a - w, a + w, x) * (1.0 - smoothstep(b - w, b + w, x));
+}
+vec3 to_linear(vec3 c) {
+	return mix(pow((c + vec3(0.055)) * (1.0 / 1.055), vec3(2.4)), c * (1.0 / 12.92), lessThan(c, vec3(0.04045)));
+}
+void fragment() {
+	vec3 col = COLOR.rgb;
+	vec3 an = abs(wn);
+	vec2 tuv = an.y > 0.5 ? wp.xz : (an.x > 0.5 ? wp.zy : wp.xy);
+	float g = texture(grime_tex, tuv * 0.18).r;
+	float rough = 0.9;
+	float spec = 0.25;
+	vec3 emit = vec3(0.0);
+	vec3 sheen = vec3(0.0);
+	if (COLOR.a > 0.5) {
+		float code = UV2.y + 0.5;
+		float burnt = floor(code / 1024.0);
+		float rem = code - burnt * 1024.0;
+		float sd = floor(rem / 4.0);
+		float sty = floor(rem - sd * 4.0);
+		float L = max(UV2.x, 1.0);
+		float u = UV.x;
+		float v = UV.y;
+		float streak = texture(grime_tex, vec2(u * 0.3 + sd * 0.17, v * 0.035)).r;
+		col *= (0.78 + 0.3 * streak) * (0.9 + 0.1 * g);
+		col *= mix(0.7, 1.0, smoothstep(0.0, 3.0, v));
+		float m = 0.0;
+		float h = 0.5;
+		if (v < ground_h) {
+			float sc = max(1.0, floor(L / 4.6 + 0.5));
+			float su = u / (L / sc);
+			float sfu = fract(su);
+			float sh = hash2(vec2(floor(su) + sd * 3.1, sd + 7.0));
+			m = band(sfu, 0.08, 0.92, fwidth(su)) * band(v, 0.35, ground_h - 0.95, fwidth(v));
+			if (sty > 0.5 && sh < 0.45) {
+				vec3 shutter = vec3(0.46, 0.47, 0.46) * (0.82 + 0.18 * step(0.5, fract(v * 5.0)));
+				col = mix(col, shutter, m);
+				m = 0.0;
+			}
+			h = sh;
+			col = mix(col, col * 0.55, band(v, ground_h - 0.85, ground_h - 0.3, fwidth(v)));
+		} else {
+			float pitch = sty < 0.5 ? 1.7 : (sty < 1.5 ? 3.0 : (sty < 2.5 ? 2.7 : 2.3));
+			float nc = max(1.0, floor(L / pitch + 0.5));
+			float cu = u / (L / nc);
+			float ci = floor(cu);
+			float fu = fract(cu);
+			float fv = (v - ground_h) / floor_h;
+			float fl = floor(fv);
+			float ff = fract(fv);
+			float wu = fwidth(cu);
+			float wv = fwidth(fv);
+			float avg = 0.3;
+			if (sty < 0.5) {
+				m = band(fu, 0.07, 0.93, wu) * band(ff, 0.24, 0.95, wv);
+				avg = 0.62;
+			} else if (sty < 1.5) {
+				m = band(fu, 0.3, 0.7, wu) * band(ff, 0.28, 0.82, wv);
+				col = mix(col, col * 0.82, band(ff, 0.0, 0.07, wv));
+				avg = 0.22;
+			} else if (sty < 2.5) {
+				m = band(fu, 0.17, 0.83, wu) * band(ff, 0.32, 0.8, wv);
+				col = mix(col, col * 0.84, band(ff, 0.0, 0.1, wv));
+				avg = 0.32;
+			} else {
+				m = band(fu, 0.33, 0.67, wu) * band(ff, 0.2, 0.84, wv);
+				col = mix(col, col * 1.1, band(ff, 0.0, 0.07, wv));
+				avg = 0.22;
+			}
+			m = mix(m, avg, smoothstep(0.25, 0.6, max(wu, wv)));
+			h = hash2(vec2(ci + sd * 13.0, fl + sd * 7.0));
+		}
+		vec3 sky = mix(vec3(0.26, 0.31, 0.37), vec3(0.5, 0.56, 0.62), fract(v * 0.06 + sd * 0.37));
+		vec3 glass = mix(vec3(0.16, 0.18, 0.2), sky, sty < 0.5 ? 0.75 : 0.5);
+		if (burnt > 0.5 || h < 0.07) {
+			glass = vec3(0.025, 0.022, 0.02);
+		} else if (h > 0.95) {
+			glass = vec3(0.95, 0.66, 0.32);
+			emit = vec3(0.5, 0.28, 0.08) * m;
+		} else if (h > 0.87) {
+			glass = vec3(0.36, 0.28, 0.19);
+		}
+		col = mix(col, glass, m);
+		sheen = sky * m * (1.0 - burnt) * step(h, 0.87) * step(0.07, h);
+		rough = mix(0.9, 0.3, m);
+		spec = mix(0.25, 0.55, m);
+		if (burnt > 0.5) {
+			col *= mix(0.62, 0.85, smoothstep(0.0, 9.0, v) * streak);
+		}
+	} else if (wn.y > 0.5) {
+		// weathered roofing felt / gravel
+		float blot = texture(grime_tex, wp.xz * 0.045 + vec2(0.3, 0.7)).r;
+		col *= (0.75 + 0.3 * blot) * (0.88 + 0.12 * g);
+	} else {
+		col *= g;
+	}
+	ALBEDO = to_linear(col);
+	ROUGHNESS = rough;
+	SPECULAR = spec;
+	// Fill light so walls in the shade of other blocks stay readable, and a
+	// fake sky reflection on the glass.
+	EMISSION = to_linear(emit) + ALBEDO * fill + to_linear(sheen) * 0.22;
+}
+"""
+
+static func material() -> ShaderMaterial:
+	if _mat:
+		return _mat
+	var sh := Shader.new()
+	sh.code = SHADER
+	_mat = ShaderMaterial.new()
+	_mat.shader = sh
+	_mat.set_shader_parameter("grime_tex", Art.grime_tex)
+	_mat.set_shader_parameter("ground_h", CityLayout.GROUND_H)
+	_mat.set_shader_parameter("floor_h", CityLayout.FLOOR_H)
+	return _mat
+
+# Rubble heap for the streets and the collapsed lot (Art.mat_vc).
+static func heap_mesh() -> ArrayMesh:
+	if _heap:
+		return _heap
+	var k := MeshKit.new()
+	var r := RandomNumberGenerator.new()
+	r.seed = 5150
+	var conc := Color(0.6, 0.58, 0.54)
+	k.sphere(1.9, Vector3(0, -0.2, 0), conc.darkened(0.25), Vector3(1.1, 0.55, 0.9), Vector3.ZERO, 8, 4)
+	for i in 14:
+		var a := r.randf() * TAU
+		var d := r.randf_range(0.2, 1.8)
+		var p := Vector3(cos(a) * d, r.randf_range(0.1, 0.8) * (1.6 - d * 0.6), sin(a) * d * 0.8)
+		var c := conc.lerp(Color(0.55, 0.36, 0.28), r.randf() * 0.6).darkened(r.randf() * 0.2)
+		k.box(Vector3(r.randf_range(0.5, 1.3), r.randf_range(0.2, 0.45), r.randf_range(0.4, 1.0)), p, c, Vector3(r.randf_range(-0.4, 0.4), r.randf() * TAU, r.randf_range(-0.4, 0.4)))
+	for i in 4:
+		var a2 := r.randf() * TAU
+		k.cyl(0.03, 0.03, 1.6, Vector3(cos(a2) * 0.8, 0.9, sin(a2) * 0.6), Color(0.35, 0.22, 0.15), Vector3(r.randf_range(-0.9, 0.9), 0, r.randf_range(-0.9, 0.9)), 4)
+	_heap = k.build()
+	return _heap
+
+# Collects towers into one mesh (a chunk of the city).
+class Batch:
+	var v := PackedVector3Array()
+	var n := PackedVector3Array()
+	var c := PackedColorArray()
+	var uv := PackedVector2Array()
+	var uv2 := PackedVector2Array()
+	var idx := PackedInt32Array()
+
+	func quad(a: Vector3, b: Vector3, cc: Vector3, d: Vector3, nrm: Vector3, col: Color, ua: Vector2, ub: Vector2, uc: Vector2, ud: Vector2, u2: Vector2) -> void:
+		var base := v.size()
+		v.append_array([a, b, cc, d])
+		uv.append_array([ua, ub, uc, ud])
+		for i in 4:
+			n.append(nrm)
+			c.append(col)
+			uv2.append(u2)
+		if (b - a).cross(cc - a).dot(nrm) > 0.0:
+			idx.append_array([base, base + 2, base + 1, base, base + 3, base + 2])
+		else:
+			idx.append_array([base, base + 1, base + 2, base, base + 2, base + 3])
+
+	# Axis-aligned block with metric facade UVs. windows=false makes a plain
+	# (roof-type) box. top=null leaves the lid off.
+	func block(x0: float, z0: float, x1: float, z1: float, y0: float, y1: float, wall: Color, code: float, windows: bool, top = null) -> void:
+		var a := 1.0 if windows else 0.0
+		var col := Color(wall.r, wall.g, wall.b, a)
+		var lx := x1 - x0
+		var lz := z1 - z0
+		quad(Vector3(x0, y0, z1), Vector3(x1, y0, z1), Vector3(x1, y1, z1), Vector3(x0, y1, z1), Vector3(0, 0, 1), col,
+			Vector2(0, y0), Vector2(lx, y0), Vector2(lx, y1), Vector2(0, y1), Vector2(lx, code))
+		quad(Vector3(x1, y0, z0), Vector3(x0, y0, z0), Vector3(x0, y1, z0), Vector3(x1, y1, z0), Vector3(0, 0, -1), col,
+			Vector2(0, y0), Vector2(lx, y0), Vector2(lx, y1), Vector2(0, y1), Vector2(lx, code))
+		quad(Vector3(x1, y0, z1), Vector3(x1, y0, z0), Vector3(x1, y1, z0), Vector3(x1, y1, z1), Vector3(1, 0, 0), col,
+			Vector2(0, y0), Vector2(lz, y0), Vector2(lz, y1), Vector2(0, y1), Vector2(lz, code))
+		quad(Vector3(x0, y0, z0), Vector3(x0, y0, z1), Vector3(x0, y1, z1), Vector3(x0, y1, z0), Vector3(-1, 0, 0), col,
+			Vector2(0, y0), Vector2(lz, y0), Vector2(lz, y1), Vector2(0, y1), Vector2(lz, code))
+		if top != null:
+			var tc: Color = top
+			quad(Vector3(x0, y1, z0), Vector3(x1, y1, z0), Vector3(x1, y1, z1), Vector3(x0, y1, z1), Vector3.UP, Color(tc.r, tc.g, tc.b, 0.0),
+				Vector2(x0, z0), Vector2(x1, z0), Vector2(x1, z1), Vector2(x0, z1), Vector2.ZERO)
+
+	# Low wall round a roof edge: outer, inner and top faces only.
+	func parapet(x0: float, z0: float, x1: float, z1: float, y0: float, h: float, t: float, col: Color) -> void:
+		var cc := Color(col.r, col.g, col.b, 0.0)
+		var y1 := y0 + h
+		block(x0, z0, x1, z1, y0, y1, col, 0.0, false)
+		var ix0 := x0 + t
+		var iz0 := z0 + t
+		var ix1 := x1 - t
+		var iz1 := z1 - t
+		var z := Vector2.ZERO
+		quad(Vector3(ix1, y0, iz1), Vector3(ix0, y0, iz1), Vector3(ix0, y1, iz1), Vector3(ix1, y1, iz1), Vector3(0, 0, -1), cc, z, z, z, z, z)
+		quad(Vector3(ix0, y0, iz0), Vector3(ix1, y0, iz0), Vector3(ix1, y1, iz0), Vector3(ix0, y1, iz0), Vector3(0, 0, 1), cc, z, z, z, z, z)
+		quad(Vector3(ix1, y0, iz0), Vector3(ix1, y0, iz1), Vector3(ix1, y1, iz1), Vector3(ix1, y1, iz0), Vector3(-1, 0, 0), cc, z, z, z, z, z)
+		quad(Vector3(ix0, y0, iz1), Vector3(ix0, y0, iz0), Vector3(ix0, y1, iz0), Vector3(ix0, y1, iz1), Vector3(1, 0, 0), cc, z, z, z, z, z)
+		var top := cc.lightened(0.08)
+		quad(Vector3(x0, y1, z0), Vector3(x1, y1, z0), Vector3(x1, y1, iz0), Vector3(x0, y1, iz0), Vector3.UP, top, z, z, z, z, z)
+		quad(Vector3(x0, y1, iz1), Vector3(x1, y1, iz1), Vector3(x1, y1, z1), Vector3(x0, y1, z1), Vector3.UP, top, z, z, z, z, z)
+		quad(Vector3(x0, y1, iz0), Vector3(ix0, y1, iz0), Vector3(ix0, y1, iz1), Vector3(x0, y1, iz1), Vector3.UP, top, z, z, z, z, z)
+		quad(Vector3(ix1, y1, iz0), Vector3(x1, y1, iz0), Vector3(x1, y1, iz1), Vector3(ix1, y1, iz1), Vector3.UP, top, z, z, z, z, z)
+
+	func kit(k: MeshKit) -> void:
+		var base := v.size()
+		v.append_array(k.verts)
+		n.append_array(k.norms)
+		uv.append_array(k.uvs)
+		for col in k.cols:
+			c.append(Color(col.r, col.g, col.b, 0.0))
+			uv2.append(Vector2.ZERO)
+		for i in k.inds:
+			idx.append(base + i)
+
+	func is_empty() -> bool:
+		return v.is_empty()
+
+	func commit() -> ArrayMesh:
+		var arrays := []
+		arrays.resize(Mesh.ARRAY_MAX)
+		arrays[Mesh.ARRAY_VERTEX] = v
+		arrays[Mesh.ARRAY_NORMAL] = n
+		arrays[Mesh.ARRAY_COLOR] = c
+		arrays[Mesh.ARRAY_TEX_UV] = uv
+		arrays[Mesh.ARRAY_TEX_UV2] = uv2
+		arrays[Mesh.ARRAY_INDEX] = idx
+		var am := ArrayMesh.new()
+		am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
+		return am
+
+static func tower_height(floors: int) -> float:
+	return CityLayout.GROUND_H + (floors - 1) * CityLayout.FLOOR_H
+
+# One tower: body, maybe a set-back top, parapet and roof clutter.
+static func add_tower(b: Batch, t: Dictionary) -> void:
+	var r: Rect2 = t["r"]
+	var floors := int(t["floors"])
+	var style := int(t["style"])
+	var sd := int(t["seed"])
+	var burnt := bool(t["burnt"])
+	var out := bool(t["out"])
+	var wall: Color = t["col"]
+	if burnt:
+		wall = wall.darkened(0.15)
+	var rng := RandomNumberGenerator.new()
+	rng.seed = sd * 7919 + floors * 31 + int(r.position.x * 13.0) + int(r.position.y * 7.0)
+	var code := float(style + 4 * sd + (1024 if burnt else 0))
+	var x0 := r.position.x
+	var z0 := r.position.y
+	var x1 := r.end.x
+	var z1 := r.end.y
+	var h := tower_height(floors)
+	var roof: Color = ROOFS[(sd + style) % ROOFS.size()]
+	if burnt:
+		roof = roof.darkened(0.3)
+	var trim := wall.darkened(0.28) if style != 3 else wall.lightened(0.12)
+	var inset := 2.0
+	var tier := floors >= 7 and minf(r.size.x, r.size.y) >= 12.0 and rng.randf() < 0.55
+	if tier:
+		var lower := floors - rng.randi_range(2, 3)
+		var h1 := tower_height(lower)
+		b.block(x0, z0, x1, z1, 0.0, h1, wall, code, true, roof)
+		b.block(x0 - 0.25, z0 - 0.25, x1 + 0.25, z1 + 0.25, h1, h1 + 0.45, trim, 0.0, false, trim)
+		x0 += inset
+		z0 += inset
+		x1 -= inset
+		z1 -= inset
+		b.block(x0, z0, x1, z1, h1 + 0.45, h, wall, code, true, roof)
+	else:
+		b.block(x0, z0, x1, z1, 0.0, h, wall, code, true, roof)
+	var over := 0.35 if style == 3 else 0.15
+	b.parapet(x0 - over, z0 - over, x1 + over, z1 + over, h, 0.75 if style != 0 else 0.5, 0.35, trim)
+	if out and floors < 9:
+		return
+	# Roof clutter: lift housing, AC units, the odd water tank or mast.
+	var k := MeshKit.new()
+	var w := x1 - x0
+	var dd := z1 - z0
+	var cx := (x0 + x1) * 0.5
+	var cz := (z0 + z1) * 0.5
+	var sx := rng.randf_range(-0.25, 0.25) * w
+	var sz := rng.randf_range(-0.25, 0.25) * dd
+	k.box(Vector3(minf(3.0, w * 0.3), 2.4, minf(2.6, dd * 0.3)), Vector3(cx + sx, h + 1.2, cz + sz), CONCRETE.darkened(rng.randf() * 0.2), Vector3.ZERO, 0.0)
+	if not out:
+		for i in rng.randi_range(1, 3):
+			var p := Vector3(cx + rng.randf_range(-0.35, 0.35) * w, h + 0.5, cz + rng.randf_range(-0.35, 0.35) * dd)
+			k.box(Vector3(1.5, 1.0, 1.1), p, METAL.lightened(rng.randf() * 0.2), Vector3(0, PI * 0.5 * rng.randi_range(0, 1), 0), 0.0)
+		if w > 9.0 and dd > 9.0:
+			var sp := Vector3(cx - sx * 0.6, h + 0.2, cz + sz * 0.3 - dd * 0.15)
+			k.box(Vector3(2.6, 0.45, 1.6), sp, Color(0.3, 0.36, 0.42), Vector3.ZERO, 0.0)
+	if style != 0 and floors >= 5 and rng.randf() < 0.45:
+		var tp := Vector3(cx - sx * 0.8, h, cz - sz * 0.8)
+		k.box(Vector3(2.4, 1.3, 2.4), tp + Vector3(0, 0.65, 0), Color(0.24, 0.23, 0.22), Vector3.ZERO, 0.0)
+		k.cyl(1.15, 1.15, 2.3, tp + Vector3(0, 2.45, 0), TANK.darkened(rng.randf() * 0.15), Vector3.ZERO, 8, 0.0)
+		k.cyl(0.0, 1.3, 0.8, tp + Vector3(0, 4.0, 0), TANK.darkened(0.3), Vector3.ZERO, 8, 0.0)
+	elif style == 0 and floors >= 8:
+		k.cyl(0.08, 0.14, 7.0, Vector3(cx + sx, h + 2.6 + 3.5, cz + sz), METAL, Vector3.ZERO, 4, 0.0)
+	b.kit(k)
diff -ruN src_orig/scripts/maps/city_builder.gd src/scripts/maps/city_builder.gd
--- a/scripts/maps/city_builder.gd	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/maps/city_builder.gd	2026-10-25 08:08:36.618609561 +0000
@@ -0,0 +1,323 @@
+class_name CityBuilder
+extends MapBuilder
+# Builds the City from CityLayout data. MapBuilder does the shops, props, plaza
+# trees and salvage wrecks; this adds the streets (several widths), the tall
+# blocks and rubble. Towers are permanent rock on the nav grid: zombies and
+# people go round them, nothing can be built on them, they can't be cleared,
+# and (unlike houses) they close off a safe zone, so walling the street
+# mouths round the plaza makes it safe.
+const CHUNK := 120.0
+var spots: Array[Vector3] = []
+var sealed := 0
+var _extra := {}
+
+func build(d: Dictionary, seed_: int) -> void:
+	layout = d
+	rng.seed = seed_
+	_city_surfaces()
+	_towers()
+	_rubble()
+	_buildings()
+	_props()
+	_trees()
+	_dead_cars()
+	_wrecks()
+	_seal_pockets()
+	_entries()
+	_flush_multimeshes()
+	_flush_extra()
+	_hide_outer_decor()
+	spots.assign(layout["spots"])
+	# A higher sun than the fields: long evening shadows would bury the
+	# streets between the blocks.
+	if G.main and G.main.get("sun") != null:
+		G.main.sun.rotation_degrees.x = -50.0
+	for m in Art.grid_materials():
+		m.set_shader_parameter("zone_tex", G.zones.mask_tex)
+	G.grid.notify_paths_changed()
+
+# --- ground -----------------------------------------------------------------
+
+func _city_surfaces() -> void:
+	var by_w := {}
+	var plain := SurfaceBuilder.new()
+	var pave := SurfaceBuilder.new()
+	var kerb := SurfaceBuilder.new()
+	var grounds := {}
+	var pw := CityLayout.PAVE_W
+	var roads: Array = layout["roads"]
+	for r in roads:
+		var a: Vector3 = r["a"]
+		var b: Vector3 = r["b"]
+		var w := float(r["w"])
+		var along := (b - a).normalized()
+		var across := Vector3(-along.z, 0, along.x)
+		var l := a.distance_to(b)
+		var x_road := absf(along.x) > 0.5
+		if not by_w.has(w):
+			by_w[w] = SurfaceBuilder.new()
+		(by_w[w] as SurfaceBuilder).strip(a, b, w, ROAD_Y, 0.0, l, w)
+		_mark_paved(a, b, w + pw * 2.0)
+		var cuts_k: Array = []
+		var cuts_p: Array = []
+		for o in roads:
+			if o == r:
+				continue
+			var oa: Vector3 = o["a"]
+			var ob: Vector3 = o["b"]
+			var od := (ob - oa).normalized()
+			if absf(od.dot(along)) > 0.5:
+				continue
+			var e0 := (oa - a).dot(across)
+			var e1 := (ob - a).dot(across)
+			if minf(e0, e1) > w * 0.5 + 0.1 or maxf(e0, e1) < -w * 0.5 - 0.1:
+				continue
+			var t := (oa - a).dot(along)
+			if t < -1.0 or t > l + 1.0:
+				continue
+			var ow := float(o["w"]) * 0.5
+			cuts_k.append(Vector2(t - ow, t + ow))
+			# x-roads keep their pavement through the corners; z-roads stop short.
+			cuts_p.append(Vector2(t - ow, t + ow) if x_road else Vector2(t - ow - pw, t + ow + pw))
+			if x_road:
+				var c := a + along * t
+				plain.strip(c - Vector3(ow, 0, 0), c + Vector3(ow, 0, 0), w, ROAD_Y + 0.004, 0.0, ow * 2.0, 8.0)
+		for side in [-1.0, 1.0]:
+			for sp in _spans(cuts_p, l):
+				var off: Vector3 = across * side * (w * 0.5 + pw * 0.5)
+				pave.strip(a + along * sp.x + off, a + along * sp.y + off, pw, PAVE_Y, sp.x, sp.y, 4.0)
+			for sp in _spans(cuts_k, l):
+				var ko: Vector3 = across * side * (w * 0.5)
+				kerb.kerb(a + along * sp.x + ko, a + along * sp.y + ko, across * side, ROAD_Y, PAVE_Y, 0.25)
+		# Streets that stop at the plaza get a kerb across the end.
+		for end in [[a, -along], [b, along]]:
+			var e: Vector3 = end[0]
+			if absf(e.x) < CityLayout.EXT - 1.0 and absf(e.z) < CityLayout.EXT - 1.0:
+				kerb.kerb(e - across * w * 0.5, e + across * w * 0.5, end[1], ROAD_Y, PAVE_Y, 0.25)
+	for g in layout["grounds"]:
+		var kind := String(g["kind"])
+		if not grounds.has(kind):
+			grounds[kind] = SurfaceBuilder.new()
+		_rect(grounds[kind], g["r"], PAVE_Y - (0.002 if kind == "pavement" else 0.0))
+		_pave_rect(g["r"])
+	var lawn: Rect2 = layout["lawn"]
+	var corners := [Vector3(lawn.position.x, 0, lawn.position.y), Vector3(lawn.end.x, 0, lawn.position.y),
+		Vector3(lawn.end.x, 0, lawn.end.y), Vector3(lawn.position.x, 0, lawn.end.y)]
+	var mid := Vector3(lawn.get_center().x, 0, lawn.get_center().y)
+	for i in 4:
+		var k0: Vector3 = corners[i]
+		var k1: Vector3 = corners[(i + 1) % 4]
+		var outward := (((k0 + k1) * 0.5) - mid)
+		outward = Vector3(signf(outward.x) if absf(outward.x) > absf(outward.z) else 0.0, 0, signf(outward.z) if absf(outward.z) >= absf(outward.x) else 0.0)
+		kerb.kerb(k0, k1, outward, 0.0, PAVE_Y, 0.2)
+	for w in by_w:
+		_add_mesh("Roads_%d" % int(w), (by_w[w] as SurfaceBuilder).commit(), Art.surface_mat("asphalt_road", float(w)))
+	_add_mesh("Junctions", plain.commit(), Art.surface_mat("asphalt", 8.0))
+	_add_mesh("Pavements", pave.commit(), Art.surface_mat("pavement", 4.0))
+	_add_mesh("Kerbs", kerb.commit(), Art.surface_mat("kerb", 1.0))
+	for kind in grounds:
+		_add_mesh("Ground_" + kind, (grounds[kind] as SurfaceBuilder).commit(), Art.surface_mat(kind, 4.0 if kind != "asphalt" else 8.0))
+
+func _spans(cuts: Array, l: float) -> Array:
+	cuts.sort_custom(func(x, y): return x.x < y.x)
+	var out: Array = []
+	var from := 0.0
+	for c in cuts:
+		if c.x > from:
+			out.append(Vector2(from, minf(c.x, l)))
+		from = maxf(from, c.y)
+	if from < l:
+		out.append(Vector2(from, l))
+	return out
+
+func _rect(sb: SurfaceBuilder, r: Rect2, y: float) -> void:
+	var A := Vector3(r.position.x, y, r.position.y)
+	var B := Vector3(r.end.x, y, r.position.y)
+	var C := Vector3(r.end.x, y, r.end.y)
+	var D := Vector3(r.position.x, y, r.end.y)
+	sb._quad(A, B, C, D, Vector2(A.x, A.z), Vector2(B.x, B.z), Vector2(C.x, C.z), Vector2(D.x, D.z), Vector3.UP)
+
+func _pave_rect(r: Rect2) -> void:
+	var c0 := Defs.world_to_cell(Vector3(r.position.x + 0.01, 0, r.position.y + 0.01))
+	var c1 := Defs.world_to_cell(Vector3(r.end.x - 0.01, 0, r.end.y - 0.01))
+	for y in range(maxi(0, c0.y), mini(Defs.H - 1, c1.y) + 1):
+		for x in range(maxi(0, c0.x), mini(Defs.W - 1, c1.x) + 1):
+			paved[G.grid.idx(Vector2i(x, y))] = true
+
+# --- towers -----------------------------------------------------------------
+
+func _towers() -> void:
+	var batches := {}
+	for t in layout["towers"]:
+		var r: Rect2 = t["r"]
+		var c := r.get_center()
+		var key := Vector2i(floori(c.x / CHUNK + 0.5), floori(c.y / CHUNK + 0.5))
+		if not batches.has(key):
+			batches[key] = CityArt.Batch.new()
+		CityArt.add_tower(batches[key], t)
+		if not bool(t["out"]):
+			_rock_rect(r)
+	for key in batches:
+		var mi := MeshInstance3D.new()
+		mi.name = "Towers_%d_%d" % [key.x, key.y]
+		mi.mesh = (batches[key] as CityArt.Batch).commit()
+		mi.material_override = CityArt.material()
+		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
+		add_child(mi)
+
+# Permanent blocker: rock on the nav grid, "Blocked" for building.
+func _rock_rect(r: Rect2) -> void:
+	var g: Grid = G.grid
+	var n0 := Defs.world_to_nav(Vector3(r.position.x + 0.05, 0, r.position.y + 0.05))
+	var n1 := Defs.world_to_nav(Vector3(r.end.x - 0.05, 0, r.end.y - 0.05))
+	for y in range(maxi(0, n0.y), mini(Defs.NH - 1, n1.y) + 1):
+		for x in range(maxi(0, n0.x), mini(Defs.NW - 1, n1.x) + 1):
+			var n := Vector2i(x, y)
+			var i := g.nidx(n)
+			g.nblk[i] = Grid.N_ROCK
+			g.nown[i] = self
+			g.terrain[g.idx(Defs.nav_to_build(n))] = Defs.T_ROCK
+
+# Open cells that nothing can reach from the map edge (a yard shut in by
+# towers) would read as a safe zone: fill them in.
+func _seal_pockets() -> void:
+	var g: Grid = G.grid
+	var nw := Defs.NW
+	var nh := Defs.NH
+	var total := nw * nh
+	var seen := PackedByteArray()
+	seen.resize(total)
+	var q := PackedInt32Array()
+	q.resize(total)
+	var qt := 0
+	for x in nw:
+		for y in [0, nh - 1]:
+			var i: int = y * nw + x
+			if seen[i] == 0 and g.nblk[i] != Grid.N_ROCK:
+				seen[i] = 1
+				q[qt] = i
+				qt += 1
+	for y in nh:
+		for x in [0, nw - 1]:
+			var i2: int = y * nw + x
+			if seen[i2] == 0 and g.nblk[i2] != Grid.N_ROCK:
+				seen[i2] = 1
+				q[qt] = i2
+				qt += 1
+	var qh := 0
+	while qh < qt:
+		var u := q[qh]
+		qh += 1
+		var ux := u % nw
+		var uy := u / nw
+		for v in [u - 1 if ux > 0 else -1, u + 1 if ux < nw - 1 else -1, u - nw if uy > 0 else -1, u + nw if uy < nh - 1 else -1]:
+			if v >= 0 and seen[v] == 0 and g.nblk[v] != Grid.N_ROCK:
+				seen[v] = 1
+				q[qt] = v
+				qt += 1
+	for i3 in total:
+		if seen[i3] == 0 and g.nblk[i3] != Grid.N_ROCK:
+			g.nblk[i3] = Grid.N_ROCK
+			g.nown[i3] = self
+			sealed += 1
+
+# --- clutter ----------------------------------------------------------------
+
+func _rubble() -> void:
+	for ru in layout["ruins"]:
+		var pos: Vector3 = ru["pos"]
+		var yaw := float(ru["yaw"])
+		var v := int(ru["v"])
+		_extra_add("ruin%d" % v, Art.ruin_mesh(v), Transform3D(Basis(Vector3.UP, yaw), pos))
+		var c := pos + Basis(Vector3.UP, yaw) * Vector3(1.3, 0, 0)
+		_block(G.grid.rect_footprint(c, yaw, 4.2, 2.8)["nav"], Grid.N_STATIC, self)
+	for hp in layout["heaps"]:
+		var pos2: Vector3 = hp["pos"]
+		var yaw2 := float(hp["yaw"])
+		_extra_add("heap", CityArt.heap_mesh(), Transform3D(Basis(Vector3.UP, yaw2), pos2))
+		_block(G.grid.rect_footprint(pos2, yaw2, 1.7, 1.3)["nav"], Grid.N_STATIC, self)
+		var s := SalvageSpot.new()
+		add_child(s)
+		s.setup(pos2, "", int(hp["scrap"]))
+		wrecks.append(s)
+
+# Wrecks with nothing left in them: one MultiMesh per model.
+func _dead_cars() -> void:
+	for w in layout["dead_cars"]:
+		var kind := SUBURB + String(w["model"])
+		var pos: Vector3 = w["pos"]
+		var yaw := float(w["yaw"])
+		_mm_add(kind, Transform3D(Basis(Vector3.UP, yaw), pos))
+		var fp: Dictionary = Art.footprint(kind)
+		var h: Vector2 = fp["half"]
+		var c: Vector3 = pos + Basis(Vector3.UP, yaw) * (fp["off"] as Vector3)
+		_block(G.grid.rect_footprint(c, yaw, maxf(0.6, h.x), maxf(0.6, h.y))["nav"], Grid.N_STATIC, self)
+
+func _extra_add(key: String, mesh: Mesh, xf: Transform3D) -> void:
+	if not _extra.has(key):
+		_extra[key] = {"mesh": mesh, "xforms": []}
+	_extra[key]["xforms"].append(xf)
+
+func _flush_extra() -> void:
+	for key in _extra:
+		var e: Dictionary = _extra[key]
+		var mm := MultiMesh.new()
+		mm.transform_format = MultiMesh.TRANSFORM_3D
+		mm.mesh = e["mesh"]
+		var xs: Array = e["xforms"]
+		mm.instance_count = xs.size()
+		for i in xs.size():
+			mm.set_instance_transform(i, xs[i])
+		var mmi := MultiMeshInstance3D.new()
+		mmi.name = "MM_" + key
+		mmi.multimesh = mm
+		mmi.material_override = Art.mat_vc
+		add_child(mmi)
+
+# The trees and rocks Decor scatters past the edge would stand inside the
+# skyline here.
+func _hide_outer_decor() -> void:
+	var decor := get_parent().get_node_or_null("Decor") if get_parent() else null
+	if decor == null:
+		return
+	for ch in decor.get_children():
+		if ch is MultiMeshInstance3D:
+			(ch as MultiMeshInstance3D).visible = false
+
+# --- spawning and survivors --------------------------------------------------
+
+# Spawn lanes are the street ends; keep the spread inside the street.
+func _entries() -> void:
+	var e: Dictionary = layout["entries"]
+	for edge in e:
+		var opts: Array = (e[edge] as Array).duplicate()
+		opts.shuffle()
+		var n := rng.randi_range(2, mini(3, opts.size()))
+		entries[edge] = opts.slice(0, n)
+
+func spawn_point(edge: int, r: RandomNumberGenerator) -> Vector3:
+	var h := Defs.HALF
+	var list: Array = entries.get(edge, [])
+	var along := 0.0
+	if not list.is_empty():
+		var en: Array = list[r.randi() % list.size()]
+		along = float(en[0]) + r.randf_range(-1.0, 1.0) * maxf(0.0, float(en[1]) - 3.5)
+	var out := r.randf_range(2.0, 7.0)
+	match edge:
+		0:
+			return Vector3(along, 0, -h - out)
+		1:
+			return Vector3(h + out, 0, along)
+		2:
+			return Vector3(along, 0, h + out)
+		_:
+			return Vector3(-h - out, 0, along)
+
+func survivor_points() -> Array[Vector3]:
+	var out: Array[Vector3] = super()
+	var g: Grid = G.grid
+	for p in spots:
+		var n := Defs.world_to_nav(p)
+		if g.ninb(n) and g.nblk[g.nidx(n)] == Grid.N_OPEN:
+			out.append(p)
+	return out
diff -ruN src_orig/scripts/maps/city_layout.gd src/scripts/maps/city_layout.gd
--- a/scripts/maps/city_layout.gd	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/maps/city_layout.gd	2026-10-25 08:08:36.618728233 +0000
@@ -0,0 +1,341 @@
+class_name CityLayout
+extends RefCounted
+# Downtown: a plaza in the middle walled in by low blocks, a ring avenue round
+# that, and cross streets running out to every edge. The horde comes in at the
+# street ends, so the streets and the plaza mouths are the chokepoints.
+# Block edges sit on odd metres so they line up with the 2 m build grid.
+const AVE_W := 12.0
+const ST_W := 8.0
+const PAVE_W := 3.0
+const EXT := 150.0
+const RING := 46.0
+const OUTER := 76.0
+const PLAZA := Rect2(-26.0, -23.0, 52.0, 46.0)
+const PROM := 3.0
+const GROUND_H := 4.2
+const FLOOR_H := 3.2
+const FACE_S := PI
+const FACE_N := 0.0
+const FACE_E := -PI * 0.5
+const FACE_W := PI * 0.5
+const LINES := [-EXT, -OUTER, -RING, 0.0, RING, OUTER, EXT]
+const PALETTES := [
+	[Color(0.56, 0.58, 0.6), Color(0.44, 0.47, 0.52), Color(0.62, 0.6, 0.55), Color(0.36, 0.4, 0.42)],
+	[Color(0.55, 0.3, 0.22), Color(0.62, 0.38, 0.27), Color(0.47, 0.31, 0.25), Color(0.6, 0.46, 0.36)],
+	[Color(0.7, 0.68, 0.62), Color(0.62, 0.62, 0.6), Color(0.72, 0.63, 0.5), Color(0.58, 0.6, 0.56)],
+	[Color(0.8, 0.74, 0.62), Color(0.74, 0.68, 0.56), Color(0.66, 0.62, 0.58), Color(0.77, 0.66, 0.52)],
+]
+
+static func data() -> Dictionary:
+	var d := {
+		"id": "city",
+		"hq": Vector3.ZERO,
+		"wave_mult": 1.2,
+		"roads": [],
+		"junctions": [],
+		"bulbs": [],
+		"lots": [],
+		"buildings": [],
+		"trees": [],
+		"props": [],
+		"wrecks": [],
+		"dead_cars": [],
+		"fences": [],
+		"drives": [],
+		"towers": [],
+		"grounds": [],
+		"ruins": [],
+		"heaps": [],
+		"spots": [],
+		"park": PLAZA,
+		"lawn": PLAZA.grow(-PROM),
+		"entries": {},
+	}
+	var r := RandomNumberGenerator.new()
+	r.seed = 7781
+	_roads(d)
+	_blocks(d, r)
+	_plaza(d)
+	_lots(d)
+	_street_furniture(d, r)
+	_wrecks(d)
+	_spots(d)
+	return d
+
+static func road_w(c: float) -> float:
+	return AVE_W if absf(absf(c) - RING) < 0.1 else ST_W
+
+static func _roads(d: Dictionary) -> void:
+	var R: Array = d["roads"]
+	for c in [-OUTER, -RING, RING, OUTER]:
+		R.append({"a": Vector3(-EXT, 0, c), "b": Vector3(EXT, 0, c), "w": road_w(c)})
+		R.append({"a": Vector3(c, 0, -EXT), "b": Vector3(c, 0, EXT), "w": road_w(c)})
+	R.append({"a": Vector3(-EXT, 0, 0), "b": Vector3(PLAZA.position.x, 0, 0), "w": ST_W})
+	R.append({"a": Vector3(PLAZA.end.x, 0, 0), "b": Vector3(EXT, 0, 0), "w": ST_W})
+	R.append({"a": Vector3(0, 0, -EXT), "b": Vector3(0, 0, PLAZA.position.y), "w": ST_W})
+	R.append({"a": Vector3(0, 0, PLAZA.end.y), "b": Vector3(0, 0, EXT), "w": ST_W})
+	var along: Array = []
+	for c in [-OUTER, -RING, 0.0, RING, OUTER]:
+		along.append([c, road_w(c) * 0.5 + PAVE_W])
+	for edge in 4:
+		d["entries"][edge] = along.duplicate(true)
+
+# Block interiors between road centrelines, minus road and pavement.
+static func _span(i: int) -> Vector2:
+	var a: float = LINES[i]
+	var b: float = LINES[i + 1]
+	var a_in := 0.0 if absf(a) >= EXT else road_w(a) * 0.5 + PAVE_W
+	var b_in := 0.0 if absf(b) >= EXT else road_w(b) * 0.5 + PAVE_W
+	return Vector2(a + a_in, b - b_in)
+
+static func _special(i: int, j: int) -> String:
+	var key := Vector2i(i, j)
+	var specials := {
+		Vector2i(4, 3): "carpark", Vector2i(1, 2): "carpark", Vector2i(3, 1): "rubble",
+		Vector2i(2, 4): "petrol", Vector2i(4, 1): "shop", Vector2i(1, 4): "shop",
+	}
+	return specials.get(key, "")
+
+static func _blocks(d: Dictionary, r: RandomNumberGenerator) -> void:
+	var h := Defs.HALF
+	for j in 6:
+		for i in 6:
+			var sx := _span(i)
+			var sz := _span(j)
+			var blk := Rect2(sx.x, sz.x, sx.y - sx.x, sz.y - sz.x)
+			if i in [2, 3] and j in [2, 3]:
+				_inner_quadrant(d, blk, r)
+				continue
+			if _special(i, j) != "":
+				continue
+			var edge := i == 0 or i == 5 or j == 0 or j == 5
+			if not edge:
+				d["grounds"].append({"r": blk, "kind": "pavement"})
+				_fill(d, blk, 1, false, r, true)
+				continue
+			# The part inside the map is solid blocks right up to the edge;
+			# the rest is skyline, drawn but not on the nav grid.
+			var inner := Rect2(Vector2(maxf(blk.position.x, -h), maxf(blk.position.y, -h)), Vector2.ZERO)
+			inner.end = Vector2(minf(blk.end.x, h), minf(blk.end.y, h))
+			d["grounds"].append({"r": blk, "kind": "pavement"})
+			if inner.size.x > 4.0 and inner.size.y > 4.0:
+				_fill(d, inner, 2, false, r, false)
+			var outs: Array = []
+			if blk.end.x > h:
+				outs.append(Rect2(h, blk.position.y, blk.end.x - h, blk.size.y))
+			if blk.position.x < -h:
+				outs.append(Rect2(blk.position.x, blk.position.y, -h - blk.position.x, blk.size.y))
+			var x0 := maxf(blk.position.x, -h)
+			var x1 := minf(blk.end.x, h)
+			if blk.end.y > h:
+				outs.append(Rect2(x0, h, x1 - x0, blk.end.y - h))
+			if blk.position.y < -h:
+				outs.append(Rect2(x0, blk.position.y, x1 - x0, -h - blk.position.y))
+			for o in outs:
+				_fill(d, o, 3, true, r, false)
+
+# The quarter of the ring round the plaza: an L of low blocks, with an alley
+# through it in some quarters.
+static func _inner_quadrant(d: Dictionary, q: Rect2, r: RandomNumberGenerator) -> void:
+	var north := q.position.y < 0.0
+	var east := q.position.x > 0.0
+	var front := Rect2(q.position.x, q.position.y if north else PLAZA.end.y, q.size.x, 0.0)
+	front.size.y = (PLAZA.position.y - q.position.y) if north else (q.end.y - PLAZA.end.y)
+	var side := Rect2(PLAZA.end.x if east else q.position.x, PLAZA.position.y if north else q.position.y, 0.0, 0.0)
+	side.size.x = (q.end.x - PLAZA.end.x) if east else (PLAZA.position.x - q.position.x)
+	side.size.y = (q.end.y - PLAZA.position.y) if north else (PLAZA.end.y - q.position.y)
+	d["grounds"].append({"r": front, "kind": "pavement"})
+	d["grounds"].append({"r": side, "kind": "pavement"})
+	# Alleys: NE runs north out of the plaza, SW south, NW west.
+	var cuts_front: Array = []
+	var cuts_side: Array = []
+	if north and east:
+		cuts_front.append(Vector2(19, 23))
+	elif not north and not east:
+		cuts_front.append(Vector2(-23, -19))
+	elif north and not east:
+		cuts_side.append(Vector2(-17, -13))
+	for piece in _cut(front, cuts_front, true):
+		_fill(d, piece, 0, false, r, false)
+	for piece in _cut(side, cuts_side, false):
+		_fill(d, piece, 0, false, r, false)
+
+static func _cut(rect: Rect2, cuts: Array, along_x: bool) -> Array:
+	var out: Array = []
+	var a := rect.position.x if along_x else rect.position.y
+	var e := rect.end.x if along_x else rect.end.y
+	for c in cuts:
+		if c.x > a:
+			out.append(_sub(rect, a, c.x, along_x))
+		a = c.y
+	if e > a:
+		out.append(_sub(rect, a, e, along_x))
+	return out
+
+static func _sub(rect: Rect2, a: float, b: float, along_x: bool) -> Rect2:
+	if along_x:
+		return Rect2(a, rect.position.y, b - a, rect.size.y)
+	return Rect2(rect.position.x, a, rect.size.x, b - a)
+
+# Split a block into buildings: frontages of 10-18 m along its long side,
+# two deep when the block is deep, sometimes a through-alley between.
+static func _fill(d: Dictionary, rect: Rect2, tier: int, out: bool, r: RandomNumberGenerator, alleys: bool) -> void:
+	var horiz := rect.size.x >= rect.size.y
+	var L := rect.size.x if horiz else rect.size.y
+	var D := rect.size.y if horiz else rect.size.x
+	var rows := 2 if D >= 24.0 else 1
+	var t := 0.0
+	var pieces: Array = []
+	while L - t > 0.5:
+		var w := float(r.randi_range(5, 9) * 2) if not out else float(r.randi_range(8, 13) * 2)
+		if L - t - w < 8.0:
+			w = L - t
+		pieces.append(Vector2(t, t + w))
+		t += w
+		if alleys and L - t > 12.0 and r.randf() < 0.25:
+			t += 4.0
+	for p in pieces:
+		var split := D
+		if rows == 2:
+			split = float(int(D * r.randf_range(0.4, 0.6) / 2.0) * 2)
+		for row in rows:
+			var d0 := 0.0 if row == 0 else split
+			var d1 := split if row == 0 else D
+			var b: Rect2
+			if horiz:
+				b = Rect2(rect.position.x + p.x, rect.position.y + d0, p.y - p.x, d1 - d0)
+			else:
+				b = Rect2(rect.position.x + d0, rect.position.y + p.x, d1 - d0, p.y - p.x)
+			_tower(d, b, tier, out, r)
+
+static func _tower(d: Dictionary, b: Rect2, tier: int, out: bool, r: RandomNumberGenerator, floors: int = 0, burnt: int = -1) -> void:
+	var lo: int = [3, 4, 5, 6][tier]
+	var hi: int = [4, 7, 9, 12][tier]
+	if floors <= 0:
+		floors = r.randi_range(lo, hi)
+		if minf(b.size.x, b.size.y) < 9.0:
+			floors = mini(floors, lo + 1)
+	var style := r.randi() % 4
+	var pal: Array = PALETTES[style]
+	var col: Color = (pal[r.randi() % pal.size()] as Color).darkened(r.randf_range(0.0, 0.12))
+	var is_burnt := r.randf() < 0.1 if burnt < 0 else burnt == 1
+	d["towers"].append({"r": b, "floors": floors, "style": style, "col": col, "seed": r.randi() % 256, "burnt": is_burnt, "out": out})
+
+static func _plaza(d: Dictionary) -> void:
+	var p := PLAZA
+	var g: Array = d["grounds"]
+	g.append({"r": Rect2(p.position.x, p.position.y, p.size.x, PROM), "kind": "pavement"})
+	g.append({"r": Rect2(p.position.x, p.end.y - PROM, p.size.x, PROM), "kind": "pavement"})
+	g.append({"r": Rect2(p.position.x, p.position.y + PROM, PROM, p.size.y - PROM * 2.0), "kind": "pavement"})
+	g.append({"r": Rect2(p.end.x - PROM, p.position.y + PROM, PROM, p.size.y - PROM * 2.0), "kind": "pavement"})
+	var T: Array = d["trees"]
+	var ring := [[-19, -16, "tree_oak"], [-8, -17, "tree_birch"], [9, -17, "tree_oak"], [19, -15, "tree_pine"],
+		[20, -4, "tree_birch"], [20, 9, "tree_oak"], [18, 17, "tree_birch"], [7, 17, "tree_pine"],
+		[-9, 17, "tree_oak"], [-19, 16, "tree_birch"], [-20, 5, "tree_oak"], [-20, -6, "tree_pine"]]
+	for t in ring:
+		T.append({"pos": Vector3(t[0], 0, t[1]), "model": t[2], "s": 0.9})
+	var P: Array = d["props"]
+	for b in [[-15, -12, 0.6], [15, -12, -0.6], [-15, 12, 2.5], [15, 12, -2.5], [-17, 0, FACE_E], [17, 0, FACE_W]]:
+		P.append({"pos": Vector3(b[0], 0, b[1]), "yaw": b[2], "model": "bench"})
+	for b in [[-13, -18], [13, 18], [-21, 11], [21, -10]]:
+		P.append({"pos": Vector3(b[0], 0, b[1]), "yaw": float(b[0]) * 0.3, "model": "bush_b" if int(b[0]) % 2 == 0 else "bush_a"})
+
+static func _lots(d: Dictionary) -> void:
+	var g: Array = d["grounds"]
+	for j in 6:
+		for i in 6:
+			var kind := _special(i, j)
+			if kind == "":
+				continue
+			var sx := _span(i)
+			var sz := _span(j)
+			var blk := Rect2(sx.x, sz.x, sx.y - sx.x, sz.y - sz.x)
+			match kind:
+				"carpark":
+					g.append({"r": blk, "kind": "asphalt"})
+				"rubble":
+					g.append({"r": blk, "kind": "gravel"})
+				_:
+					g.append({"r": blk, "kind": "pavement" if kind == "shop" else "asphalt"})
+	var B: Array = d["buildings"]
+	B.append({"pos": Vector3(-22, 0, 62), "yaw": FACE_N, "model": "petrol_station"})
+	B.append({"pos": Vector3(62, 0, -62.5), "yaw": FACE_S, "model": "corner_shop"})
+	B.append({"pos": Vector3(-62, 0, 62.5), "yaw": FACE_N, "model": "corner_shop"})
+	# The rubble lot: a burnt-out stump, collapsed walls and heaps to pick through.
+	var r := RandomNumberGenerator.new()
+	r.seed = 12
+	_tower(d, Rect2(31, -69, 6, 14), 0, false, r, 2, 1)
+	d["ruins"].append({"pos": Vector3(13, 0, -63), "yaw": 0.3, "v": 0})
+	d["ruins"].append({"pos": Vector3(24, 0, -61), "yaw": 2.6, "v": 1})
+	var H: Array = d["heaps"]
+	H.append({"pos": Vector3(19, 0, -66.5), "yaw": 0.4, "scrap": Defs.SALVAGE_SCRAP + 40})
+	H.append({"pos": Vector3(27, 0, -57.5), "yaw": 1.9, "scrap": Defs.SALVAGE_SCRAP + 40})
+	# Rubble spilt into the streets: they narrow a lane, never close one.
+	H.append({"pos": Vector3(-59, 0, -77.5), "yaw": 0.1, "scrap": Defs.SALVAGE_SCRAP})
+	H.append({"pos": Vector3(77.5, 0, 31), "yaw": 1.5, "scrap": Defs.SALVAGE_SCRAP})
+	H.append({"pos": Vector3(-30, 0, 78), "yaw": 3.0, "scrap": Defs.SALVAGE_SCRAP})
+	H.append({"pos": Vector3(-77.5, 0, -24), "yaw": 1.7, "scrap": Defs.SALVAGE_SCRAP})
+	var P: Array = d["props"]
+	for b in [[57, -57, 0.0], [67, -67, PI], [-57, 57, 0.0], [-67, 67, PI]]:
+		P.append({"pos": Vector3(b[0], 0, b[1]), "yaw": b[2], "model": "bins"})
+
+static func _street_furniture(d: Dictionary, r: RandomNumberGenerator) -> void:
+	var P: Array = d["props"]
+	var h := Defs.HALF
+	for rd in d["roads"]:
+		var a: Vector3 = rd["a"]
+		var b: Vector3 = rd["b"]
+		var w := float(rd["w"])
+		var along := (b - a).normalized()
+		var across := Vector3(-along.z, 0, along.x)
+		var l := a.distance_to(b)
+		var k := 0
+		var t := 10.0
+		while t < l:
+			var p := a + along * t
+			t += 22.0
+			if absf(p.x) > h - 6.0 or absf(p.z) > h - 6.0:
+				continue
+			var at: float = p.x if absf(along.x) > 0.5 else p.z
+			var near_x := false
+			for c in [-OUTER, -RING, 0.0, RING, OUTER]:
+				if absf(at - c) < 11.0:
+					near_x = true
+			if near_x:
+				continue
+			k += 1
+			var side := 1.0 if k % 2 == 0 else -1.0
+			var lp := p + across * side * (w * 0.5 + 0.9)
+			# The lamp arm points along local -z: turn it to hang over the road.
+			var to_road := -across * side
+			P.append({"pos": lp, "yaw": atan2(-to_road.x, -to_road.z), "model": "streetlight"})
+			if r.randf() < 0.35:
+				P.append({"pos": p + across * -side * (w * 0.5 + 1.2) + along * 3.0, "yaw": atan2(-along.x, -along.z), "model": "bins"})
+
+static func _wrecks(d: Dictionary) -> void:
+	var W: Array = d["wrecks"]
+	var w := [
+		[22, -45, 84, "school_bus_wreck"], [-30, -47.5, 100, "car_sedan_wreck"], [-46.5, -20, 8, "car_hatch_wreck"],
+		[45, 22, -10, "van_wreck"], [60, 46.5, 95, "car_hatch_wreck"], [0.5, -60, 5, "car_sedan_wreck"],
+		[-75, 30, 172, "van_wreck"], [-20, 76.5, 92, "school_bus_wreck"], [36, -1, -84, "car_sedan_wreck"],
+		[59, 15, 0, "car_sedan_wreck"], [65, 24, 190, "car_hatch_wreck"], [-60, -15, 0, "car_sedan_wreck"],
+		[-11, 60, 12, "car_hatch_wreck"],
+	]
+	for e in w:
+		W.append({"pos": Vector3(e[0], 0, e[1]), "yaw": deg_to_rad(float(e[2])), "model": e[3]})
+	var C: Array = d["dead_cars"]
+	var c := [
+		[47.8, 28, 22, "car_sedan_wreck"], [43.5, 31, -35, "car_hatch_wreck"], [76.5, -20, -6, "car_sedan_wreck"],
+		[-38, 0.8, 88, "car_hatch_wreck"], [30, 75, 75, "car_sedan_wreck"], [1.5, 34, -15, "car_hatch_wreck"],
+		[-60, 45, 80, "van_wreck"], [-46, 60, 176, "car_sedan_wreck"], [62, -76.5, 98, "van_wreck"],
+		[-65, -28, 186, "car_hatch_wreck"], [64, 30, 4, "van_wreck"], [-1.5, 61, 170, "car_sedan_wreck"],
+		[-62, -46.5, 263, "car_sedan_wreck"], [76, 62, 8, "car_hatch_wreck"],
+	]
+	for e in c:
+		C.append({"pos": Vector3(e[0], 0, e[1]), "yaw": deg_to_rad(float(e[2])), "model": e[3]})
+
+static func _spots(d: Dictionary) -> void:
+	var S: Array = d["spots"]
+	for p in [[62, 20], [-62, -22], [10, -57], [-12, 52], [0, -66], [66, 0], [0, 64], [-66, 0],
+			[52, -76], [-60, 76], [76, 52], [-76, -60], [30, -46], [-46, 30], [62, -52], [-62, 52]]:
+		S.append(Vector3(p[0], 0, p[1]))
