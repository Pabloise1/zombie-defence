+			var ab: Dictionary = G.net.anchor_near(pb, pa)
+			if not aa.is_empty() and not ab.is_empty():
+				b = G.buildings.place_bridge({"pos": pa, "ref": aa["ref"]}, {"pos": pb, "ref": ab["ref"]}, built)
