+func _on_card_action(id: String, target) -> void:
+	if id.begins_with("plus:") or id.begins_with("minus:"):
+		var key := id.get_slice(":", 1)
+		if key in ["zspeed", "horde", "spawn"]:
+			_step_setting(key, 1 if id.begins_with("plus:") else -1)
+			return
+	if id.begins_with("plus:"):
+		var job := id.substr(5)
+		var why: String = people.add_job(job)
+		if why != "":
+			hud.toast(why)
+			_ui("ui_invalid")
+		else:
+			_ui("ui_recruit" if job == "soldier" else "ui_assign")
+		return
+	if id.begins_with("minus:"):
+		var why2: String = people.remove_job(id.substr(6))
+		if why2 != "":
+			hud.toast(why2)
+			_ui("ui_invalid")
+		else:
+			_ui("ui_cancel")
+		return
+	if id.begins_with("mount:"):
+		var gun := id.substr(6)
+		var why3 := ""
+		if target is CardModels.SlotPick:
+			if target.seg != null:
